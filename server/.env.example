NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/farmrelay
APP_ORIGIN=http://localhost:5173
# Generate a random value of at least 32 characters. Retain it securely for MFA encryption.
APP_SECRET=
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# SMTP credentials must belong to a verified sender service.
SMTP_URL=
MAIL_FROM=FarmRelay <no-reply@example.com>
TRUST_PROXY_HOPS=1
SERVE_WEB=true
